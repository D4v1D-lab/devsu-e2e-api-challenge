{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Devsu API Challenge",
    "description": "API tests for signup and login.\n\nNOTE: {{baseUrl}} is a placeholder. Confirm the real API base URL with the hiring team before running against a real environment.\nCommon demo alternative used here: https://api.demoblaze.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.demoblaze.com"
    },
    {
      "key": "signupUsername",
      "value": ""
    },
    {
      "key": "signupPassword",
      "value": "TestPass123!"
    }
  ],
  "item": [
    {
      "name": "POST /signup - success",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const unique = `user_${Date.now()}_${Math.floor(Math.random() * 10000)}`;",
              "pm.collectionVariables.set('signupUsername', unique);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response body indicates success (empty errorMessage or empty object)', function () {",
              "    const json = pm.response.json();",
              "    // Demoblaze returns empty body \"\" or {} on success; errorMessage on failure",
              "    const bodyText = pm.response.text();",
              "    const hasError = json && json.errorMessage;",
              "    pm.expect(hasError).to.not.be.ok;",
              "    pm.expect(bodyText === '' || bodyText === '{}' || (json && !json.errorMessage)).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{signupUsername}}\",\n  \"password\": \"{{signupPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/signup",
          "host": ["{{baseUrl}}"],
          "path": ["signup"]
        },
        "description": "Create a new user. Username is generated uniquely in the pre-request script."
      }
    },
    {
      "name": "POST /login - valid credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains Auth_token', function () {",
              "    const body = pm.response.text();",
              "    pm.expect(body).to.include('Auth_token');",
              "});",
              "",
              "pm.test('No errorMessage in response', function () {",
              "    const json = pm.response.json();",
              "    if (typeof json === 'object' && json !== null) {",
              "        pm.expect(json.errorMessage).to.be.undefined;",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{signupUsername}}\",\n  \"password\": \"{{signupPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": ["{{baseUrl}}"],
          "path": ["login"]
        },
        "description": "Login with the user created in the signup request."
      }
    },
    {
      "name": "POST /login - invalid credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    // Demoblaze returns HTTP 200 even for auth failures",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response body contains errorMessage', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('errorMessage');",
              "    pm.expect(json.errorMessage).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.test('Error indicates invalid credentials or missing user', function () {",
              "    const msg = pm.response.json().errorMessage.toLowerCase();",
              "    const ok = msg.includes('wrong') || msg.includes('not exist') || msg.includes('invalid') || msg.includes('password');",
              "    pm.expect(ok).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"definitely_not_a_real_user_xyz_999\",\n  \"password\": \"wrong_password_xyz\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": ["{{baseUrl}}"],
          "path": ["login"]
        },
        "description": "Login with invalid credentials — expects an error payload."
      }
    }
  ]
}
